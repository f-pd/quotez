{
  "name": "Quotez",
  "short_name": "Quotez",
  "description": "A quote of the day, from the RFC 865 protocol to your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f0f0f",
